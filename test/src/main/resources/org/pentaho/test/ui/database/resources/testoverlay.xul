<overlay 
  xmlns="http://www.pentaho.org/keymaster/gatekeeper/there.is.only.xul">
  <listbox id="deck-options-list" flex="0" width="100"  height="400"/>
  <listitem id="advanced-item" removeelement="true"/>
  <listitem id="pooling-item" removeelement="true"/>
  <listitem id="cluster-item" removeelement="true"/>

  <groupbox id="advanced-group-box" removeelement="true"/>
  <groupbox id="pooling-group" removeelement="true"/>
  <groupbox id="place-holder-box-2" removeelement="true"/>

  <listbox id="connection-type-list" flex="0" width="250" height="170"/>
  <listbox id="access-type-list" flex="0" width="250"  height="80"/>

  <hbox id="all-box" height="400" flex="0" width="650" />
  <hbox id="connection-access-list-box" height="350" flex="0" width="535" />
  <vbox id="type-box" height="350" flex="0" width="258" />
  <groupbox id="database-options-box" height="350" flex="0" width="268" />
  <textbox id="connection-name-text" width="545" />
  <vbox flex="0" id="main-container" height="400" />

</overlay>
